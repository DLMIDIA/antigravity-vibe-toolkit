#!/usr/bin/env node

/**
 * Antigravity Vibe Toolkit CLI (agy-vibe)
 * Autonomous Quality Gates, Project Scaffolding & Skill Management for Google Antigravity
 *
 * Inspired by and building upon vibe-coding-toolkit by Matheus Gomes (soumatheusgomes)
 * Adapted and engineered specifically for Google DeepMind's Antigravity platform.
 */

const fs = require('fs');
const path = require('path');
const { execSync, spawnSync } = require('child_process');
const os = require('os');

const PKG_ROOT = path.resolve(__dirname, '..');
const CWD = process.cwd();
const HOME = os.homedir();

// ANSI Colors
const colors = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  cyan: '\x1b[36m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  red: '\x1b[31m',
  magenta: '\x1b[35m',
  blue: '\x1b[34m',
};

function log(msg, color = colors.reset) {
  console.log(`${color}${msg}${colors.reset}`);
}

function header(title) {
  console.log(`\n${colors.bold}${colors.cyan}=== ${title} ===${colors.reset}\n`);
}

function success(msg) {
  console.log(`${colors.green}✔ ${msg}${colors.reset}`);
}

function warn(msg) {
  console.log(`${colors.yellow}⚠ ${msg}${colors.reset}`);
}

function error(msg) {
  console.log(`${colors.red}✖ ${msg}${colors.reset}`);
}

function info(msg) {
  console.log(`${colors.dim}ℹ ${msg}${colors.reset}`);
}

// ---------------------------------------------------------------------------
// 1. HELP COMMAND
// ---------------------------------------------------------------------------
function printHelp() {
  console.log(`
${colors.bold}${colors.cyan}Antigravity Vibe Toolkit${colors.reset} — ${colors.dim}Supercharged Agentic Coding for Google Antigravity${colors.reset}

${colors.bold}USAGE:${colors.reset}
  ${colors.green}agy-vibe${colors.reset} <command> [options]

${colors.bold}COMMANDS:${colors.reset}
  ${colors.green}init${colors.reset} [dir]            Scaffold the Antigravity Vibe Coding foundation (PRODUCT.md, AGENTS.md, docs, rules)
  ${colors.green}verify${colors.reset}                Run the full Quality Gate pipeline (lines, types, lint, tests, build) with evidence
  ${colors.green}sanitize${colors.reset}              Scan for files > 350 lines, dead artifacts, and code smells
  ${colors.green}dashboard${colors.reset}             Start the local visual Monitor Dashboard & Obsidian Memory Vault on :4242
  ${colors.green}dock${colors.reset}                  Launch compact Side-by-Side Companion window alongside Antigravity
  ${colors.green}autopilot${colors.reset} [dir]        Analyze project stack, match compatible skills & run health audits
  ${colors.green}schedule${colors.reset} [cadence]     Configure automated background recurring health checks (daily, 30m)
  ${colors.green}install-skills${colors.reset}        Install Antigravity skills globally (~/.gemini/antigravity/builtin/skills/)
  ${colors.green}status${colors.reset}                Check current project compliance with Antigravity Vibe standards

${colors.bold}OPTIONS:${colors.reset}
  ${colors.yellow}-h, --help${colors.reset}            Show this help menu
  ${colors.yellow}-v, --version${colors.reset}         Show current version

${colors.dim}Base inspiration: github.com/soumatheusgomes/vibe-coding-toolkit
Adapted specifically for Google Antigravity by Daniel Junior Barbosa da Silva${colors.reset}
`);
}

// ---------------------------------------------------------------------------
// 2. STATUS COMMAND
// ---------------------------------------------------------------------------
function checkStatus(targetDir = CWD) {
  header('Antigravity Vibe Compliance Check');
  log(`Scanning target directory: ${targetDir}`, colors.dim);

  const checks = [
    { file: 'PRODUCT.md', desc: 'Product scope & acceptance criteria' },
    { file: 'AGENTS.md', desc: 'Canonical agent instructions' },
    { file: 'GEMINI.md', desc: 'Antigravity workspace rules bridge' },
    { file: 'docs/architecture.md', desc: 'System architecture & boundaries' },
    { file: 'docs/quality.md', desc: 'Quality gates & verification standards' },
    { file: 'docs/setup.md', desc: 'Environment prerequisites & evidence' },
    { file: '.agents/rules', isDir: true, desc: 'Workspace rule directory' },
    { file: '.agents/skills', isDir: true, desc: 'Workspace skills directory' },
  ];

  let passed = 0;
  for (const c of checks) {
    const p = path.join(targetDir, c.file);
    const exists = fs.existsSync(p);
    if (exists) {
      success(`${c.file.padEnd(24)} [Found] - ${c.desc}`);
      passed++;
    } else {
      warn(`${c.file.padEnd(24)} [Missing] - ${c.desc}`);
    }
  }

  console.log(`\nScore: ${passed}/${checks.length} compliance points.`);
  if (passed === checks.length) {
    log('🎉 This project is fully compliant with Antigravity Vibe Coding!', colors.green);
  } else {
    log('💡 Run "agy-vibe init" to scaffold missing files automatically.', colors.yellow);
  }
}

// ---------------------------------------------------------------------------
// 3. SANITIZE / FILE SIZE CHECK (350-line rule)
// ---------------------------------------------------------------------------
function scanDirectoryForLineLimits(dir, maxLines = 350, ignoreDirs = ['node_modules', '.git', 'dist', 'build', '.next', 'brain', 'venv', '.venv', 'env', '__pycache__', '.gradle', 'site-packages', 'backup', 'backups', 'vendor', 'assets']) {
  const largeFiles = [];

  function walk(current, depth = 0) {
    if (depth > 5) return;
    let entries = [];
    try {
      entries = fs.readdirSync(current, { withFileTypes: true });
    } catch (e) {
      return;
    }
    for (const entry of entries) {
      if (entry.name.startsWith('.') && entry.name !== '.agents') continue;
      if (ignoreDirs.includes(entry.name)) continue;

      const fullPath = path.join(current, entry.name);
      if (entry.isDirectory()) {
        walk(fullPath, depth + 1);
      } else if (entry.isFile()) {
        const ext = path.extname(entry.name).toLowerCase();
        if (['.ts', '.tsx', '.js', '.jsx', '.py', '.go', '.rs', '.php', '.vue', '.svelte', '.html', '.css'].includes(ext)) {
          try {
            const st = fs.statSync(fullPath);
            if (st.size > 400000) continue;
            const content = fs.readFileSync(fullPath, 'utf8');
            const lines = content.split('\n').length;
            if (lines > maxLines) {
              largeFiles.push({ file: path.relative(dir, fullPath), lines });
            }
          } catch (e) {
            // Ignore unreadable files
          }
        }
      }
    }
  }

  walk(dir, 0);
  return largeFiles;
}

function runSanitize(targetDir = CWD) {
  header('Codebase Sanitation & 350-Line Limit Check');
  log(`Scanning for source files exceeding 350 lines in: ${targetDir}`, colors.dim);

  const largeFiles = scanDirectoryForLineLimits(targetDir);

  if (largeFiles.length === 0) {
    success('All source files adhere to the 350-line modular limit! Perfect modularity.');
  } else {
    warn(`Found ${largeFiles.length} file(s) exceeding 350 lines:`);
    largeFiles.sort((a, b) => b.lines - a.lines);
    for (const f of largeFiles) {
      console.log(`  ${colors.red}${f.lines.toString().padStart(5)} lines${colors.reset} -> ${colors.bold}${f.file}${colors.reset}`);
    }
    log('\n💡 Recommendation: Break these files down into focused submodules with single responsibilities.', colors.yellow);
    log('   Activate the skill "modular-350-refactor" in Antigravity to refactor them automatically.', colors.dim);
  }
}

// ---------------------------------------------------------------------------
// 4. VERIFY / QUALITY GATES
// ---------------------------------------------------------------------------
function runVerify(targetDir = CWD) {
  header('Antigravity Quality Gates Verification');
  log('Evaluating "Evidence-First" verification pipeline...', colors.dim);

  const results = [];

  // Gate 1: 350-Line Limit
  const largeFiles = scanDirectoryForLineLimits(targetDir);
  if (largeFiles.length === 0) {
    results.push({ gate: 'Modularity (<=350 lines)', status: 'PASS', detail: 'All source files within modular bounds.' });
  } else {
    results.push({ gate: 'Modularity (<=350 lines)', status: 'WARN', detail: `${largeFiles.length} file(s) exceed 350 lines.` });
  }

  // Detect Package Manager / Stack
  const hasPackageJson = fs.existsSync(path.join(targetDir, 'package.json'));
  const hasRequirements = fs.existsSync(path.join(targetDir, 'requirements.txt')) || fs.existsSync(path.join(targetDir, 'pyproject.toml'));

  // Gate 2: Typescript / Typecheck
  if (hasPackageJson) {
    const pkg = JSON.parse(fs.readFileSync(path.join(targetDir, 'package.json'), 'utf8'));
    const scripts = pkg.scripts || {};

    // Typecheck
    if (scripts.typecheck || fs.existsSync(path.join(targetDir, 'tsconfig.json'))) {
      const cmd = scripts.typecheck ? 'npm run typecheck' : 'npx tsc --noEmit';
      log(`Running Typecheck: ${cmd}`, colors.dim);
      const res = spawnSync(cmd, { shell: true, cwd: targetDir, stdio: 'pipe' });
      if (res.status === 0) {
        results.push({ gate: 'Typecheck', status: 'PASS', detail: '0 type errors found.' });
      } else {
        results.push({ gate: 'Typecheck', status: 'FAIL', detail: res.stderr.toString() || res.stdout.toString() });
      }
    }

    // Lint
    if (scripts.lint) {
      log(`Running Lint: npm run lint`, colors.dim);
      const res = spawnSync('npm run lint', { shell: true, cwd: targetDir, stdio: 'pipe' });
      if (res.status === 0) {
        results.push({ gate: 'Linter', status: 'PASS', detail: 'Clean lint report.' });
      } else {
        results.push({ gate: 'Linter', status: 'FAIL', detail: res.stderr.toString() || res.stdout.toString() });
      }
    }

    // Test
    if (scripts.test && !scripts.test.includes('no test specified')) {
      log(`Running Tests: npm test`, colors.dim);
      const res = spawnSync('npm test', { shell: true, cwd: targetDir, stdio: 'pipe' });
      if (res.status === 0) {
        results.push({ gate: 'Automated Tests', status: 'PASS', detail: 'All test suites passing.' });
      } else {
        results.push({ gate: 'Automated Tests', status: 'FAIL', detail: res.stderr.toString() || res.stdout.toString() });
      }
    }

    // Build
    if (scripts.build) {
      log(`Running Build Check: npm run build`, colors.dim);
      const res = spawnSync('npm run build', { shell: true, cwd: targetDir, stdio: 'pipe' });
      if (res.status === 0) {
        results.push({ gate: 'Production Build', status: 'PASS', detail: 'Build completed successfully.' });
      } else {
        results.push({ gate: 'Production Build', status: 'FAIL', detail: res.stderr.toString() || res.stdout.toString() });
      }
    }
  }

  // Gate for Python
  if (hasRequirements) {
    log('Python environment detected. Checking syntax with py_compile...', colors.dim);
    const res = spawnSync('python3 -m compileall -q .', { shell: true, cwd: targetDir, stdio: 'pipe' });
    if (res.status === 0) {
      results.push({ gate: 'Python Syntax Check', status: 'PASS', detail: 'All python files compile cleanly.' });
    } else {
      results.push({ gate: 'Python Syntax Check', status: 'FAIL', detail: res.stderr.toString() });
    }
  }

  // Print Summary Table
  console.log('\n' + colors.bold + '--- EVIDENCE REPORT ---' + colors.reset);
  let allPass = true;
  for (const r of results) {
    if (r.status === 'PASS') {
      success(`${r.gate.padEnd(28)} [PASS] -> ${r.detail}`);
    } else if (r.status === 'WARN') {
      warn(`${r.gate.padEnd(28)} [WARN] -> ${r.detail}`);
    } else {
      error(`${r.gate.padEnd(28)} [FAIL] -> ${r.detail.slice(0, 100)}...`);
      allPass = false;
    }
  }

  console.log('\n' + colors.bold + 'Conclusion:' + colors.reset);
  if (allPass) {
    log('✅ All active quality gates passed. Safe to deliver!', colors.green);
  } else {
    log('❌ Quality gates failed. Review errors above before marking ready.', colors.red);
    process.exitCode = 1;
  }
}

// ---------------------------------------------------------------------------
// 5. INIT / SCAFFOLD COMMAND
// ---------------------------------------------------------------------------
function runInit(targetDir = CWD) {
  header('Scaffolding Antigravity Vibe Coding Setup');
  log(`Destination: ${targetDir}`, colors.dim);

  const templatesDir = path.join(PKG_ROOT, 'templates');
  const projectDocsDir = path.join(templatesDir, 'project-docs');

  // Ensure directories
  const dirs = [
    path.join(targetDir, 'docs'),
    path.join(targetDir, '.agents'),
    path.join(targetDir, '.agents', 'rules'),
    path.join(targetDir, '.agents', 'skills'),
  ];
  for (const d of dirs) {
    fs.mkdirSync(d, { recursive: true });
  }

  // Copy or template core docs
  const filesToCopy = [
    { src: path.join(templatesDir, 'product.md.template'), dst: path.join(targetDir, 'PRODUCT.md') },
    { src: path.join(templatesDir, 'AGENTS.md.template'), dst: path.join(targetDir, 'AGENTS.md') },
    { src: path.join(templatesDir, 'GEMINI.md.template'), dst: path.join(targetDir, 'GEMINI.md') },
    { src: path.join(projectDocsDir, 'architecture.md.template'), dst: path.join(targetDir, 'docs', 'architecture.md') },
    { src: path.join(projectDocsDir, 'quality.md.template'), dst: path.join(targetDir, 'docs', 'quality.md') },
    { src: path.join(projectDocsDir, 'setup.md.template'), dst: path.join(targetDir, 'docs', 'setup.md') },
    { src: path.join(projectDocsDir, 'onboarding.md.template'), dst: path.join(targetDir, 'docs', 'onboarding.md') },
    { src: path.join(projectDocsDir, 'design.md.template'), dst: path.join(targetDir, 'docs', 'design.md') },
  ];

  for (const item of filesToCopy) {
    if (!fs.existsSync(item.dst)) {
      if (fs.existsSync(item.src)) {
        fs.copyFileSync(item.src, item.dst);
        success(`Created ${path.relative(targetDir, item.dst)}`);
      } else {
        warn(`Template not found: ${item.src}`);
      }
    } else {
      info(`Preserved existing ${path.relative(targetDir, item.dst)}`);
    }
  }

  // Copy rules into .agents/rules/
  const srcRulesDir = path.join(PKG_ROOT, 'rules');
  if (fs.existsSync(srcRulesDir)) {
    const rules = fs.readdirSync(srcRulesDir);
    for (const r of rules) {
      const srcRule = path.join(srcRulesDir, r);
      const dstRule = path.join(targetDir, '.agents', 'rules', r);
      if (!fs.existsSync(dstRule)) {
        fs.copyFileSync(srcRule, dstRule);
        success(`Installed rule: .agents/rules/${r}`);
      }
    }
  }

  log('\n🎉 Setup completed successfully!', colors.green);
  log('Google Antigravity will now automatically discover and enforce all guidelines.', colors.cyan);
}

// ---------------------------------------------------------------------------
// 6. INSTALL SKILLS COMMAND (Global to ~/.gemini/antigravity/builtin/skills/)
// ---------------------------------------------------------------------------
function runInstallSkills() {
  header('Installing Skills into Antigravity');
  const homeDir = os.homedir();
  const globalSkillsDir = path.join(homeDir, '.gemini', 'antigravity', 'builtin', 'skills');

  log(`Target directory: ${globalSkillsDir}`, colors.dim);
  fs.mkdirSync(globalSkillsDir, { recursive: true });

  const srcSkillsDir = path.join(PKG_ROOT, 'skills');
  if (!fs.existsSync(srcSkillsDir)) {
    error('Skills directory not found in toolkit.');
    return;
  }

  const skillFolders = fs.readdirSync(srcSkillsDir, { withFileTypes: true })
    .filter(dirent => dirent.isDirectory())
    .map(dirent => dirent.name);

  for (const s of skillFolders) {
    const src = path.join(srcSkillsDir, s);
    const dst = path.join(globalSkillsDir, s);

    // Recursively copy skill folder
    fs.cpSync(src, dst, { recursive: true, force: true });
    success(`Installed Antigravity Skill: ${colors.bold}${s}${colors.reset}`);
  }

  log('\n✨ All skills installed! They are now active in Google Antigravity across your entire machine.', colors.green);
}

// ---------------------------------------------------------------------------
// 7. AUTOPILOT & SKILL ORCHESTRATION
// ---------------------------------------------------------------------------
function runAutopilot(targetDir = CWD, scheduleArg = null) {
  header('Antigravity Skill Orchestrator & Auto-Pilot');
  log(`Scanning project profile & evaluating skill compatibility in: ${targetDir}\n`, colors.dim);

  // 1. Stack Profiling
  const hasPackageJson = fs.existsSync(path.join(targetDir, 'package.json'));
  const hasTsConfig = fs.existsSync(path.join(targetDir, 'tsconfig.json'));
  const hasRequirements = fs.existsSync(path.join(targetDir, 'requirements.txt')) || fs.existsSync(path.join(targetDir, 'pyproject.toml'));
  const hasComposer = fs.existsSync(path.join(targetDir, 'composer.json'));
  const hasEnv = fs.existsSync(path.join(targetDir, '.env'));
  
  const largeFiles = scanDirectoryForLineLimits(targetDir);
  
  const hasProduct = fs.existsSync(path.join(targetDir, 'PRODUCT.md'));
  const hasAgents = fs.existsSync(path.join(targetDir, 'AGENTS.md'));
  const hasGemini = fs.existsSync(path.join(targetDir, 'GEMINI.md'));
  const missingManifests = (!hasProduct || !hasAgents || !hasGemini);

  let hasWebUI = false;
  let hasPhpFiles = false;
  try {
    const files = fs.readdirSync(targetDir);
    hasWebUI = files.some(f => f.endsWith('.html') || f.endsWith('.css') || f === 'css' || f === 'src' || f === 'public');
    hasPhpFiles = files.some(f => f.endsWith('.php') || f === 'php');
  } catch(e) {}

  // 2. Compatibility Matrix
  const skillsMatrix = [
    {
      skill: 'modular-350-refactor',
      trigger: largeFiles.length > 0 ? `${largeFiles.length} arquivo(s) > 350 linhas` : 'Modularidade 100% aderente',
      score: largeFiles.length > 0 ? 100 : 25,
      status: largeFiles.length > 0 ? 'CRITICAL' : 'OPTIONAL',
      action: largeFiles.length > 0 ? 'Desmembrar módulos com padrão Facade' : 'Manter monitoramento de limites'
    },
    {
      skill: 'security-auditor',
      trigger: (hasEnv || hasComposer || hasPackageJson || hasPhpFiles) ? 'Rotas/dependências/ambiente ativos' : 'Superfície padrão',
      score: hasEnv ? 95 : 85,
      status: 'RECOMMENDED',
      action: 'Auditar vazamento de chaves, injeções e permissões'
    },
    {
      skill: 'evidence-first',
      trigger: 'Verificação contínua de integridade (Quality Gate)',
      score: 95,
      status: 'RECOMMENDED',
      action: 'Executar testes, lint e typecheck com prova no terminal'
    },
    {
      skill: 'project-bootstrap',
      trigger: missingManifests ? 'Faltam PRODUCT.md / AGENTS.md' : 'Manifestos já presentes',
      score: missingManifests ? 95 : 20,
      status: missingManifests ? 'HIGH' : 'LOW',
      action: missingManifests ? 'Inicializar estrutura de governança ASEM' : 'Governança já configurada'
    },
    {
      skill: 'chrome-devtools',
      trigger: hasWebUI ? 'Interface Web / DOM / CSS detectada' : 'Sem UI web visível',
      score: hasWebUI ? 90 : 15,
      status: hasWebUI ? 'RECOMMENDED' : 'LOW',
      action: hasWebUI ? 'Inspecionar console, rede e responsividade' : 'Dispensável para backend puro'
    },
    {
      skill: 'context7-docs',
      trigger: (hasPackageJson || hasComposer || hasRequirements) ? 'Dependências externas presentes' : 'Sem dependências externas',
      score: 85,
      status: 'RECOMMENDED',
      action: 'Carregar documentações atualizadas das bibliotecas'
    },
    {
      skill: 'parallel-waves',
      trigger: largeFiles.length >= 2 ? `${largeFiles.length} frentes de refatoração simultâneas` : 'Poucas tarefas paralelas',
      score: largeFiles.length >= 2 ? 85 : 30,
      status: largeFiles.length >= 2 ? 'HIGH' : 'LOW',
      action: 'Distribuir refatorações paralelas em subagentes independentes'
    },
    {
      skill: 'subagent-review',
      trigger: 'Auditoria multi-perspectiva (Arquiteto, Segurança, QA)',
      score: 80,
      status: 'RECOMMENDED',
      action: 'Validar mudanças de arquitetura com múltiplos subagentes'
    },
    {
      skill: 'skill-orchestrator',
      trigger: 'Orquestrador mestre ativo',
      score: 100,
      status: 'ACTIVE',
      action: 'Supervisionar ciclo de vida e agendamentos periódicos'
    }
  ];

  skillsMatrix.sort((a, b) => b.score - a.score);

  log('📊 Skill Compatibility & Recommendation Matrix:', colors.bold);
  console.log('--------------------------------------------------------------------------------------------------');
  console.log(` ${colors.bold}SKILL${colors.reset.padEnd(25)} ${colors.bold}COMPATIBILIDADE${colors.reset.padEnd(16)} ${colors.bold}GATILHO DETECTADO${colors.reset.padEnd(35)} ${colors.bold}AÇÃO RECOMENDADA${colors.reset}`);
  console.log('--------------------------------------------------------------------------------------------------');

  for (const item of skillsMatrix) {
    let scoreColor = colors.green;
    if (item.score < 50) scoreColor = colors.dim;
    else if (item.score < 80) scoreColor = colors.yellow;

    const skillCol = item.skill.padEnd(24);
    const scoreCol = `${scoreColor}${item.score}% [${item.status}]${colors.reset}`.padEnd(26);
    const triggerCol = item.trigger.slice(0, 32).padEnd(33);
    const actionCol = item.action;

    console.log(` ${skillCol} ${scoreCol} ${triggerCol} ${actionCol}`);
  }
  console.log('--------------------------------------------------------------------------------------------------\n');

  // Immediate Action Execution
  const topAction = skillsMatrix.find(s => s.status === 'CRITICAL' || s.score >= 95);
  if (topAction) {
    log(`🎯 Ação Imediata Prioritária: ${colors.bold}${topAction.skill}${colors.reset}`, colors.cyan);
    log(`   Motivo: ${topAction.trigger}`, colors.dim);
    log(`   Ação: ${topAction.action}\n`, colors.dim);
  }

  // Handle schedule option
  if (scheduleArg) {
    runSchedule(scheduleArg, targetDir);
  } else {
    log('💡 Dica: Para agendar esta verificação de forma recorrente (ex: a cada 30min ou diária):', colors.dim);
    log('   agy-vibe schedule 30m', colors.cyan);
    log('   agy-vibe schedule daily\n', colors.cyan);
  }
}

function runSchedule(cadence = 'daily', targetDir = CWD) {
  header('Antigravity Background Scheduler');
  const sidecarDir = path.join(HOME, '.gemini', 'config', 'sidecars', 'vibe-autopilot');
  fs.mkdirSync(sidecarDir, { recursive: true });

  let cronExpression = 'CRON_TZ=America/Sao_Paulo 0 9 * * *';
  let humanCadence = 'Diariamente às 09:00';

  if (cadence === '30m' || cadence === 'half-hourly') {
    cronExpression = 'CRON_TZ=America/Sao_Paulo */30 * * * *';
    humanCadence = 'A cada 30 minutos';
  } else if (cadence === 'hourly' || cadence === '1h') {
    cronExpression = 'CRON_TZ=America/Sao_Paulo 0 * * * *';
    humanCadence = 'A cada hora';
  }

  const sidecarConfig = {
    builtin: 'schedule',
    args: [
      cronExpression,
      `Execute Antigravity Vibe Auto-Pilot in workspace ${targetDir}: audit modularity (<=350 lines), security vulnerabilities, and quality gates. Update the dashboard at http://localhost:4242.`
    ],
    display_name: `Antigravity Auto-Pilot (${humanCadence})`
  };

  const sidecarPath = path.join(sidecarDir, 'sidecar.json');
  fs.writeFileSync(sidecarPath, JSON.stringify(sidecarConfig, null, 2), 'utf8');

  success(`Agendamento Automático criado com sucesso!`);
  log(`Frequência: ${colors.bold}${humanCadence}${colors.reset} (${cronExpression})`, colors.green);
  log(`Arquivo de configuração: ${sidecarPath}`, colors.dim);
  log(`O Antigravity agora executará o Auto-Pilot periodicamente em segundo plano, registrando tudo no monitor :4242.\n`, colors.dim);
}

// ---------------------------------------------------------------------------
// MAIN ROUTER
// ---------------------------------------------------------------------------
const args = process.argv.slice(2);
const command = args[0] || 'help';

switch (command) {
  case 'init':
    runInit(args[1] ? path.resolve(args[1]) : CWD);
    break;
  case 'verify':
    runVerify(args[1] ? path.resolve(args[1]) : CWD);
    break;
  case 'sanitize':
    runSanitize(args[1] ? path.resolve(args[1]) : CWD);
    break;
  case 'install-skills':
    runInstallSkills();
    break;
  case 'status':
    checkStatus(args[1] ? path.resolve(args[1]) : CWD);
    break;
  case 'dashboard':
  case 'monitor': {
    const serverPath = path.join(PKG_ROOT, 'scripts', 'dashboard-server.js');
    header('Iniciando Antigravity Vibe Monitor');
    log('Abrindo dashboard em http://localhost:4242 ...', colors.cyan);
    try {
      if (process.platform === 'darwin') {
        setTimeout(() => {
          try { execSync('open http://localhost:4242'); } catch (e) {}
        }, 1000);
      }
    } catch (e) {}
    require(serverPath);
    break;
  }
  case 'dock':
  case 'sidecar': {
    const serverPath = path.join(PKG_ROOT, 'scripts', 'dashboard-server.js');
    header('Iniciando Antigravity Side-by-Side Companion');
    log('Abrindo painel lateral docked em http://localhost:4242/?mode=docked ...', colors.cyan);
    try {
      if (process.platform === 'darwin') {
        setTimeout(() => {
          try {
            // Try opening as standalone compact app window if Chrome exists, otherwise regular open
            execSync('open -na "Google Chrome" --args --app=http://localhost:4242/?mode=docked --window-size=440,850 2>/dev/null || open "http://localhost:4242/?mode=docked"');
          } catch (e) {
            try { execSync('open "http://localhost:4242/?mode=docked"'); } catch (err) {}
          }
        }, 1000);
      }
    } catch (e) {}
    require(serverPath);
    break;
  }
  case 'autopilot':
  case 'orchestrate': {
    const target = args[1] && !args[1].startsWith('--') ? path.resolve(args[1]) : CWD;
    const scheduleIndex = args.indexOf('--schedule');
    const scheduleVal = scheduleIndex !== -1 ? args[scheduleIndex + 1] : null;
    runAutopilot(target, scheduleVal);
    break;
  }
  case 'schedule': {
    const cadence = args[1] || 'daily';
    const target = args[2] ? path.resolve(args[2]) : CWD;
    runSchedule(cadence, target);
    break;
  }
  case '-v':
  case '--version':
    console.log('Antigravity Vibe Toolkit v1.0.0 (Google Antigravity Edition)');
    break;
  case '-h':
  case '--help':
  default:
    printHelp();
    break;
}
